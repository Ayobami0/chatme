{
  "expo": {
    "name": "chatme",
    "slug": "chatme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chatme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ilerioluwa.chatme"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ilerioluwa.chatme"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/SF-Pro/SFProDisplay-Regular.otf",
            "./src/assets/fonts/SF-Pro/SFProDisplay-Bold.otf",
            "./src/assets/fonts/SF-Pro/SFProDisplay-Medium.otf",
            "./src/assets/fonts/SF-Pro/SFProDisplay-SemiBold.otf"
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ],
      "expo-router",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow $(PRODUCT_NAME) to access your contacts."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FFFA",
          "image": "./src/assets/images/splash_logo.png",
          "imageWidth": 128,
          "imageHeight": 176
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photo library to choose and view media.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos and videos to your device.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": ["audio", "photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
