{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@core/*": [
        "./src/core/*"
      ],
      "@constants": [
        "./src/shared/constants.ts"
      ],
      "@components": [
        "./src/shared/components/index.ts"
      ],
      "@logging": [
        "./src/core/logging/index.ts"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@utils/*": [
        "./src/shared/utils/*"
      ],
      "@svg/*": [
        "./src/shared/components/svg/*"
      ],
      "@theme/*": [
        "./src/shared/theme/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@services/*": [
        "./src/services/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "metro.config.js",
    "tailwind.config.js",
    "nativewind-env.d.ts"
, "src/core/query/index.t"  ]
}
